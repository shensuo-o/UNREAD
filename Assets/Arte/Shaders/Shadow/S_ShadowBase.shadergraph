{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "f857acf0bbda448f9cb21236c8462d15",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "ShadowNoise3D (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1257.0,
            "y": 500.0,
            "width": 249.0,
            "height": 101.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "2f3024a39fab4a71b70635aaab386153"
        },
        {
            "m_Id": "d635c976da834b8185ed492f1beb5593"
        },
        {
            "m_Id": "c127a10eb0294923924e73cd8aa9428b"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "ShadowNoise3D",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float3 p = Position * Scale;\r\n\r\nfloat3 cell = floor(p);\r\nfloat3 f = frac(p);\r\n\r\n// Suavizado cúbico\r\nf = f * f * (3.0 - 2.0 * f);\r\n\r\n// Hash 3D independiente para cada esquina\r\nfloat h000 = frac(sin(dot(cell + float3(0,0,0), float3(127.1,311.7,74.7))) * 43758.5453);\r\nfloat h100 = frac(sin(dot(cell + float3(1,0,0), float3(127.1,311.7,74.7))) * 43758.5453);\r\nfloat h010 = frac(sin(dot(cell + float3(0,1,0), float3(127.1,311.7,74.7))) * 43758.5453);\r\nfloat h110 = frac(sin(dot(cell + float3(1,1,0), float3(127.1,311.7,74.7))) * 43758.5453);\r\n\r\nfloat h001 = frac(sin(dot(cell + float3(0,0,1), float3(127.1,311.7,74.7))) * 43758.5453);\r\nfloat h101 = frac(sin(dot(cell + float3(1,0,1), float3(127.1,311.7,74.7))) * 43758.5453);\r\nfloat h011 = frac(sin(dot(cell + float3(0,1,1), float3(127.1,311.7,74.7))) * 43758.5453);\r\nfloat h111 = frac(sin(dot(cell + float3(1,1,1), float3(127.1,311.7,74.7))) * 43758.5453);\r\n\r\n// Interpolación X\r\nfloat x00 = lerp(h000, h100, f.x);\r\nfloat x10 = lerp(h010, h110, f.x);\r\nfloat x01 = lerp(h001, h101, f.x);\r\nfloat x11 = lerp(h011, h111, f.x);\r\n\r\n// Interpolación Y\r\nfloat y0 = lerp(x00, x10, f.y);\r\nfloat y1 = lerp(x01, x11, f.y);\r\n\r\n// Interpolación Z\r\nNoise = lerp(y0, y1, f.z);"
}

