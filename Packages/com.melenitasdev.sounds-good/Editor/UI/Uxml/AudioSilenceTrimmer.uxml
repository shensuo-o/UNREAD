<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Packages/com.melenitasdev.sounds-good/Editor/UI/USS/MyStyles.uss?fileID=7433441132597879392&amp;guid=0ad9ef4d423fca64486bf660aba95f99&amp;type=3#MyStyles" />
    <ui:VisualElement name="Margins" style="flex-grow: 1; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgba(255, 125, 0, 0); border-right-color: rgba(255, 125, 0, 0); border-top-color: rgba(255, 125, 0, 0); border-bottom-color: rgba(255, 125, 0, 0);">
        <ui:VisualElement name="Header" style="flex-grow: 0; height: auto; flex-direction: column; justify-content: center; min-height: 78px; border-left-color: rgb(255, 184, 119); border-right-color: rgb(255, 184, 119); border-top-color: rgb(255, 184, 119); border-bottom-color: rgb(255, 184, 119); border-top-width: 4px; border-right-width: 4px; border-bottom-width: 4px; border-left-width: 4px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; background-color: rgba(135, 64, 0, 0.13); padding-top: 15px; padding-bottom: 15px;">
            <ui:Label tabindex="-1" text="AUDIO OPTIMIZER" parse-escape-sequences="true" display-tooltip-when-elided="true" focusable="false" name="Title" class="title" />
            <ui:Label tabindex="-1" text="Trim the silence that makes sounds feel late" parse-escape-sequences="true" display-tooltip-when-elided="true" focusable="false" name="Subtitle" style="color: rgb(255, 222, 179); -unity-text-align: middle-center; -unity-font-style: bold; -unity-font: url(&quot;project://database/Packages/com.melenitasdev.sounds-good/Runtime/Fonts/Geoform.otf?fileID=12800000&amp;guid=b37aee31547af254fb2483d0f52e8602&amp;type=3#Geoform&quot;); -unity-font-definition: initial; height: 14px; font-size: 13px; margin-top: 2px;" />
        </ui:VisualElement>
        <ui:VisualElement name="Content" style="flex-grow: 1; border-left-color: rgb(255, 184, 119); border-right-color: rgb(255, 184, 119); border-top-color: rgb(255, 184, 119); border-bottom-color: rgb(255, 184, 119); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; padding-top: 8px; padding-right: 8px; padding-bottom: 8px; padding-left: 8px; margin-top: 4px;">
            <ui:VisualElement name="OptionsSection" style="flex-grow: 0; margin-bottom: 8px; border-left-color: rgb(188, 128, 73); border-right-color: rgb(188, 128, 73); border-top-color: rgb(188, 128, 73); border-bottom-color: rgb(188, 128, 73); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px; padding-top: 8px; padding-right: 8px; padding-bottom: 8px; padding-left: 8px;">
                <MelenitasDev.SoundsGood.Editor.SG_BoolField space="44" label="Convert to WAV" value="true" name="ConvertToWavField" tooltip="Rewrites the clip as an uncompressed WAV. A compressed file can't be trimmed without re-encoding it, and re-encoding puts the codec's padding straight back, so trimming a non-WAV always goes through this.&#10;&#10;On its own it changes nothing you can hear: the WAV keeps whatever silence the source had. Its value is giving you a lossless source you can trim, now or later.&#10;&#10;Clips that are already WAV ignore this." />
                <MelenitasDev.SoundsGood.Editor.SG_BoolField space="44" label="Trim leading silence" value="true" name="TrimSilenceField" tooltip="Removes the silence at the start of the clip, which is what actually fixes a sound feeling late. A little is kept in front of the attack, set by Keep Before Attack below.&#10;&#10;CAREFUL WITH DYNAMIC MUSIC: its layers play together and stay in sync because they start at the same sample. Trimming each layer by a different amount desyncs the mix, and nothing will warn you — it just sounds wrong. Either leave music untrimmed, or check that its layers all have the same leading silence.&#10;&#10;For one-shot SFX this is always safe." />
                <MelenitasDev.SoundsGood.Editor.SG_FloatField name="SilenceThresholdField" default-value="-60" value="-60" suffix="dB" right-space="4" label="Silence Threshold" left-space="32" tooltip="Level under which a sample counts as silence, in dBFS. Silence in a file is rarely pure digital zero: a fade, dither or a lossy codec leave a very quiet floor, and anything stricter than that floor finds no silence at all.&#10;&#10;-60 dB is inaudible and catches those cases. Lower it (-80) to only cut true digital zeros. Raise it (-40) if a clip clearly starts late but the scan reports nothing — though too high will start eating the quiet attack of the sound itself.&#10;&#10;Rescan after changing it." />
                <MelenitasDev.SoundsGood.Editor.SG_Slider name="KeepBeforeAttackField" value="1" min="0" max="20" decimals="1" suffix="ms" right-space="4" label="Keep Before Attack" space="24" tooltip="How much of the original silence is left in front of the first audible sample, in milliseconds (0-20).&#10;&#10;It is not padding, it is a guard: cut exactly on the transient and the file starts mid-waveform, which is heard as a click. 1 ms is inaudible and safe — and for reference, Unity's default DSP buffer already costs around 40 ms, so this is a fortieth of a delay you have anyway.&#10;&#10;Raise it (5-10) if a sound has a soft attack that begins under the Silence Threshold and gets clipped. Set it to 0 only if you need the cut on the exact sample and have checked the result doesn't click." />
            </ui:VisualElement>
            <ui:VisualElement name="Toolbar" style="flex-grow: 0; flex-direction: row; margin-bottom: 6px;">
                <ui:Button text="Scan project" parse-escape-sequences="true" display-tooltip-when-elided="true" name="ScanButton" class="light-orange-button" style="height: 28px; width: 40%; margin-left: 0;" />
                <ui:Button text="Select all" parse-escape-sequences="true" display-tooltip-when-elided="true" name="SelectAllButton" class="light-orange-button" style="height: 28px; flex-grow: 1;" />
                <ui:Button text="Select none" parse-escape-sequences="true" display-tooltip-when-elided="true" name="SelectNoneButton" class="light-orange-button" style="height: 28px; flex-grow: 1; margin-right: 0;" />
            </ui:VisualElement>
            <ui:VisualElement name="ListHeader" style="flex-grow: 0; flex-direction: row; padding-left: 4px; padding-right: 4px; padding-bottom: 3px; border-bottom-width: 1px; border-bottom-color: rgb(188, 128, 73);">
                <ui:Label tabindex="-1" text="" name="ColSelect" style="width: 22px; font-size: 10px; color: rgb(196, 160, 118);" />
                <ui:Label tabindex="-1" text="TAG" name="ColTag" style="width: 90px; font-size: 10px; color: rgb(196, 160, 118); -unity-font-style: bold;" />
                <ui:Label tabindex="-1" text="FILE" name="ColFile" style="flex-grow: 1; font-size: 10px; color: rgb(196, 160, 118); -unity-font-style: bold;" />
                <ui:Label tabindex="-1" text="FMT" name="ColFormat" style="width: 42px; font-size: 10px; color: rgb(196, 160, 118); -unity-font-style: bold;" />
                <ui:Label tabindex="-1" text="SILENCE" name="ColSilence" style="width: 70px; font-size: 10px; color: rgb(196, 160, 118); -unity-font-style: bold; -unity-text-align: middle-right;" />
            </ui:VisualElement>
            <ui:ScrollView scroll-deceleration-rate="0,135" elasticity="0,1" horizontal-scroller-visibility="Hidden" name="RowsScroll" style="flex-grow: 1;">
                <ui:VisualElement name="RowsContainer" style="flex-grow: 1;" />
            </ui:ScrollView>
            <ui:Label tabindex="-1" text="Press Scan to measure every registered clip." parse-escape-sequences="true" display-tooltip-when-elided="true" focusable="false" name="SummaryLabel" style="white-space: normal; font-size: 10px; color: rgb(196, 160, 118); margin-top: 6px; margin-left: 2px;" />
            <ui:Button text="Apply to selected" parse-escape-sequences="true" display-tooltip-when-elided="true" name="ApplyButton" class="create-button" style="height: 31px; margin-top: 6px; margin-left: 0; margin-right: 0;" />
        </ui:VisualElement>
        <ui:VisualElement name="Footer" style="flex-grow: 0; height: 50px; flex-direction: row; background-color: rgba(53, 53, 53, 0.47); padding-bottom: 5px; flex-shrink: 0; margin-top: 8px; border-left-color: rgb(144, 102, 63); border-right-color: rgb(144, 102, 63); border-top-color: rgb(144, 102, 63); border-bottom-color: rgb(144, 102, 63); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px;">
            <ui:VisualElement name="SoundsGoodLogo" style="flex-grow: 1; background-image: url(&quot;project://database/Packages/com.melenitasdev.sounds-good/Runtime/Graphics/Sounds%20Good%20Logo.png?fileID=21300000&amp;guid=40d3666c3bce13a44a14505589e039c1&amp;type=3#Sounds Good Logo&quot;); -unity-background-scale-mode: scale-to-fit; margin-right: -30px;" />
            <ui:VisualElement name="MelenitasLogo" style="flex-grow: 1; background-image: url(&quot;project://database/Packages/com.melenitasdev.sounds-good/Runtime/Graphics/Unity%20Splash%20Screen.png?fileID=21300000&amp;guid=c1e1f39348c9d484088bb69d52beddfd&amp;type=3#Unity Splash Screen&quot;); -unity-background-scale-mode: scale-to-fit; height: auto; margin-top: -25px; margin-bottom: -30px; margin-left: -30px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
